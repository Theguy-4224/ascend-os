rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/routines/{routineId} { allow read, write: if isOwner(userId); }
    match /users/{userId}/expenses/{expenseId} { allow read, write: if isOwner(userId); }
    match /users/{userId}/lifts/{liftId} { allow read, write: if isOwner(userId); }
    match /users/{userId}/settings/dashboard { allow read, write: if isOwner(userId); }
  }
}
